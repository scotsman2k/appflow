# Runtime-only configuration for an existing three-tier application.
# Do not commit a populated env file. No access keys or passwords belong here.
APP_MODE=live
AWS_REGION=us-east-1
DASHBOARD_PORT=8787
ASG_NAME=EXISTING_ASG_NAME
TARGET_GROUP_ARN=arn:aws:elasticloadbalancing:us-east-1:000000000000:targetgroup/EXISTING_TARGET_GROUP/EXAMPLE
ALB_NAME=EXISTING_ALB_NAME
RDS_IDENTIFIER=EXISTING_RDS_IDENTIFIER
DB_HOST=EXISTING_PRIVATE_RDS_ENDPOINT
DB_NAME=EXISTING_DATABASE_NAME
DB_PORT=5432
# Reference an existing Secrets Manager secret; never paste credentials.
DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:EXISTING_SECRET
RDS_CA_BUNDLE=/etc/pki/tls/certs/rds-global-bundle.pem
S3_BUCKET=EXISTING_SOURCE_BUCKET
S3_SENTINEL_KEY=EXISTING_READABLE_OBJECT_KEY
S3_REPLICA_BUCKET=EXISTING_REPLICA_BUCKET
# First validate with false; enable only after existing permissions and paths work.
ENABLE_DEMO_PROBES=false
INVENTORY_TTL_MS=30000
PROBE_TIMEOUT_MS=3500
